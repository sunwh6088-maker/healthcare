# 复制为 .env 后按需修改（.env 已被 gitignore）
# MySQL root 密码（必填）
MYSQL_ROOT_PASSWORD=change-me

# 后端数据库账号密码
DB_PASSWORD=healthcare_dev

# 本地演示可设为 true；生产必须设为 false 并配置短信 Webhook
APP_DEV_MODE=true

# HTTPS 部署时设为 true（Cookie 的 Secure 标记）
AUTH_COOKIE_SECURE=false

# 允许跨域的前端地址（同域部署时可不改）
CORS_ALLOWED_ORIGINS=http://localhost:8088

# 短信 Webhook：POST {"phone","code","scene"}，为空时生产环境发送验证码会失败
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# 限流
SEND_CODE_COOLDOWN_SECONDS=60
SEND_CODE_MAX_PER_HOUR=10
LOGIN_MAX_ATTEMPTS_PER_10_MIN=10
# 每个登录用户每小时最多修改手机号次数
PHONE_CHANGE_MAX_PER_HOUR=5
# 按来源 IP 的登录/验证码限制
LOGIN_IP_MAX_PER_10_MIN=100
SEND_CODE_IP_MAX_PER_HOUR=30

# 前端映射到宿主机的端口
WEB_PORT=8088
