# 复制为 .env 后按需修改（.env 已被 gitignore）
# MySQL root 密码（必填）
MYSQL_ROOT_PASSWORD=change-me

# 后端数据库账号密码
DB_PASSWORD=healthcare_dev

# 本地演示可设为 true；生产必须设为 false 并配置短信 Webhook
APP_DEV_MODE=true

# HTTPS 部署时设为 true（Cookie 的 Secure 标记）
AUTH_COOKIE_SECURE=false

# 允许跨域的前端地址（同域部署时可不改）
CORS_ALLOWED_ORIGINS=http://localhost:8088

# 短信 Webhook：POST {"phone","code","scene"}，为空时生产环境发送验证码会失败
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Web Push（生产必须配置固定密钥，可用 npx web-push generate-vapid-keys 生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@healthcare.example

# 通用 MQTT 设备接入（EMQX / Mosquitto / 阿里云 MQTT 版）
# 开发环境没有 broker 时可保持 false，使用设备页的「模拟上报」
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=healthcare-api
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=sys/+/+/thing/event/property/post
MQTT_QOS=1

# 限流
SEND_CODE_COOLDOWN_SECONDS=60
SEND_CODE_MAX_PER_HOUR=10
LOGIN_MAX_ATTEMPTS_PER_10_MIN=10
# 每个登录用户每小时最多修改手机号次数
PHONE_CHANGE_MAX_PER_HOUR=5
# 按来源 IP 的登录/验证码限制
LOGIN_IP_MAX_PER_10_MIN=100
SEND_CODE_IP_MAX_PER_HOUR=30
# 敏感操作（改手机号/注销/首次设密码）验证码每小时上限
STEP_UP_MAX_PER_HOUR=5

# 前端映射到宿主机的端口
WEB_PORT=8088
